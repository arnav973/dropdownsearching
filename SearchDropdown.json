{
  "id": "com.arnav.searchdropdown",
  "version": "1.8.8",
  "name": "Search Dropdown",
  "description": "Searchable dropdown custom widget",
  "newInstancePrefix": "com.arnav.searchdropdown",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-arnav-searchdropdown",
      "url": "SearchDropdown.js",
      "integrity": ""
    },
    {
      "kind": "builder",
      "tag": "com-arnav-searchdropdown-builder",
      "url": "SearchDropdown_Builder.js",
      "integrity": ""
    }
  ],
  "properties": {
    "placeholder": {
      "type": "string",
      "default": "Search..."
    },
    "items": {
      "type": "string",
      "default": "[]"
    }
  },
  "events": {
    "onSelectionChange": {
      "parameters": {
        "key": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
