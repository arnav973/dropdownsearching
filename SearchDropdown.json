{
  "id": "com.arnav.searchdropdown",
  "version": "1.0.9",
  "name": "Search Dropdown",
  "description": "Searchable dropdown custom widget",
  "newInstancePrefix": "com.arnav.searchdropdown",
  "icon": "search_widget_icon_66.png",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-arnav-searchdropdown",
      "url": "SearchDropdown.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "builder",
      "tag": "com-arnav-searchdropdown-builder",
      "url": "SearchDropdown_Builder.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "placeholder": {
      "type": "string",
      "default": "Search..."
    },
    "items": {
      "type": "string",
      "default": "[]"
    }
  },
  "methods": {
    "setData": {
      "description": "Set dropdown data"
    },
    "getSelectedKey": {
      "description": "Get selected key"
    },
    "getSelectedText": {
      "description": "Get selected text"
    },
    "clear": {
      "description": "Clear selection"
    },
    "selectByKey": {
      "description": "Select by key"
    }
  },
  "events": {
    "onSelectionChange": {
      "description": "Fired when selection changes"
    }
  }
}
