{
  "id": "com.arnav.searchdropdown.local",
  "version": "1.6.3",
  "name": "Search Dropdown",
  "description": "Dropdown for SAC Planning",
  "newInstancePrefix": "SearchDropdown",
  "vendor": "Arnav Choudhary",
  "icon": "search_widget_icon_66.png",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-arnav-searchdropdown",
      "url": "SearchDropdown.js"
    },
    {
      "kind": "builder",
      "tag": "com-arnav-searchdropdown-builder",
      "url": "SearchDropdown_Builder.js"
    }
  ],
  "properties": {
    "placeholder": {
      "type": "string",
      "default": "Search..."
    },
    "items": {
      "type": "string",
      "default": "[]"
    }
  },
  "methods": {
    "setData": {
      "description": "Load JSON array string into dropdown",
      "parameters": [
        {
          "name": "jsonString",
          "type": "string"
        }
      ]
    },
    "getSelectedKey": {
      "description": "Returns the key of the selected item",
      "returnType": "string"
    },
    "getSelectedText": {
      "description": "Returns the text of the selected item",
      "returnType": "string"
    },
    "clear": {
      "description": "Clears current selection and input"
    },
    "selectByKey": {
      "description": "Programmatically select item by key",
      "parameters": [
        {
          "name": "key",
          "type": "string"
        }
      ]
    }
  },
  "events": {
    "onSelectionChange": {
      "description": "Fired when user selects an item. detail = { key, text }"
    }
  }
}
