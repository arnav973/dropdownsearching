{
  "id": "com.arnav.searchdropdown",
  "version": "1.6.2",
  "name": "Search Dropdown",
  "description": "Dropdown for SAC Planning",
  "newInstancePrefix": "SearchDropdown",
  "vendor": "Arnav Choudhary",
  "icon": "data:image/png;base64,",  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-arnav-searchdropdown",
      "url": "https://arnav973.github.io/dropdownsearching/SearchDropdown.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "builder",
      "tag": "com-arnav-searchdropdown-builder",
      "url": "https://arnav973.github.io/dropdownsearching/SearchDropdown_Builder.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],

  "properties": {

    "placeholder": {
      "type": "string",
      "default": "Search..."
    },

    "items": {
      "type": "string",
      "default": "[]"
    }

  },

  "methods": {

    "setData": {
      "description": "Load JSON array string into dropdown",
      "parameters": [
        {
          "name": "jsonString",
          "type": "string"
        }
      ]
    },

    "getSelectedKey": {
      "description": "Returns the key of the selected item",
      "returnType": "string"
    },

    "getSelectedText": {
      "description": "Returns the text of the selected item",
      "returnType": "string"
    },

    "clear": {
      "description": "Clears current selection and input"
    },

    "selectByKey": {
      "description": "Programmatically select item by key",
      "parameters": [
        {
          "name": "key",
          "type": "string"
        }
      ]
    }

  },

  "events": {

    "onSelectionChange": {
      "description": "Fired when user selects an item. detail = { key, text }"
    }

  }
}
